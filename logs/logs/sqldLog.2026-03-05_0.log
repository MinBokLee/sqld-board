[2026-03-05 15:29:59.826] [INFO ] [http-nio-8881-exec-4] jdbc.sqlonly - SELECT
            B.BOARD_ID,
            B.TITLE,
            B.CONTENT,
            M.USER_ID,
            M.USER_NAME,
            B.MEMBER_ID,
            B.BOARD_TYPE,
            B.CATEGORY,
            B.VIEW_COUNT,
            B.LIKE_COUNT,
            M.PROFILE_IMAGE,
            B.CREATE_AT,
            B.UPDATE_AT,
            B.TAG_NAME
        FROM
            BOARD B
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
         WHERE MATCH(TITLE, CONTENT) AGAINST('select*' IN BOOLEAN MODE)

                AND B.BOARD_TYPE = 'S' 
        ORDER BY
            B.CREATE_AT DESC
        LIMIT 0, 10


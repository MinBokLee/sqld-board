[2026-03-10 15:40:20.984] [INFO ] [http-nio-8881-exec-7] jdbc.sqlonly - SELECT
            B.BOARD_ID,
            B.TITLE,
            B.CONTENT,
            M.USER_ID,
            M.USER_NAME,
            B.MEMBER_ID,
            B.BOARD_TYPE,
            B.CATEGORY,
            B.VIEW_COUNT,
            B.LIKE_COUNT,
            M.PROFILE_IMAGE,
            B.CREATE_AT,
            B.UPDATE_AT,
            B.TAG_NAME
        FROM
            BOARD B
        INNER JOIN (
            /* 인덱스만 사용하여 필요한 ID들만 빠르게 추출 */
            SELECT BOARD_ID
            FROM BOARD
             WHERE  BOARD_TYPE = 'G' 
            ORDER BY CREATE_AT DESC
            LIMIT 10 OFFSET 0
        ) AS temp ON B.BOARD_ID = temp.BOARD_ID
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        ORDER BY B.CREATE_AT DESC


             , B.VIEW_COUNT
             , B.LIKE_COUNT
             , M.PROFILE_IMAGE
             , B.CREATE_AT
             , B.UPDATE_AT
             , B.TAG_NAME
          FROM BOARD B
    INNER JOIN ( /* 인덱스만 사용하여 필요한 ID들만 빠르게 추출 */
                SELECT BOARD_ID
                  FROM BOARD
             WHERE  BOARD_TYPE = 'S'

                    AND MEMBER_ID = 'MEMBER_20260212_005' 
            ORDER BY CREATE_AT DESC
            LIMIT 10 OFFSET 0
        ) AS temp ON B.BOARD_ID = temp.BOARD_ID
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        ORDER BY B.CREATE_AT DESC

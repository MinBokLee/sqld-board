            B.TITLE,
            B.CONTENT,
            M.USER_ID,
            M.USER_NAME,
            B.MEMBER_ID,
            B.BOARD_CODE,
            B.categoryId,
            B.VIEW_COUNT,
            B.LIKE_COUNT,
            M.PROFILE_IMAGE,
            B.CREATE_AT,

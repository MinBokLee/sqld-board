            B.VIEW_COUNT,
            B.LIKE_COUNT,
            M.PROFILE_IMAGE,
            B.CREATE_AT,
            B.UPDATE_AT,
            B.TAG_NAME
        FROM
            BOARD B
        INNER JOIN (
            /* 인덱스만 사용하여 필요한 ID들만 빠르게 추출 */
            SELECT BOARD_ID

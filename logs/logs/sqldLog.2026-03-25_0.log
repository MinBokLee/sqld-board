             , B.TITLE
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             , B.CREATE_AT
             , M.USER_NAME
             , M.PROFILE_IMAGE
        FROM BOARD B
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        WHERE B.CREATE_AT >= DATE_SUB(NOW(), INTERVAL 7 DAY)
        ORDER BY B.LIKE_COUNT DESC, B.VIEW_COUNT DESC
        LIMIT 5

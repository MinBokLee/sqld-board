[2026-04-21 23:38:56.461] [INFO ] [http-nio-8881-exec-9] jdbc.sqltiming - SELECT /* BoardMapper.getBoardListWithPaging (페이징 처리된 게시판 목록 조회 (지연 조인 최적화 적용)) */
               B.BOARD_ID
             , B.TITLE
             , B.CONTENT
             , M.USER_ID
             , M.USER_NAME
             , B.MEMBER_ID
             , B.BOARD_CODE
             , B.CATEGORY_ID
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             ,(SELECT COUNT(*)
                 FROM COMMENT_MANAGEMENT CM
                 WHERE CM.BOARD_ID = B.BOARD_ID
                   AND CM.DELETE_YN = 'N') AS commentCount /* 댓글 작성 수 */

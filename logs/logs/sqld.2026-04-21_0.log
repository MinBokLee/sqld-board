[2026-04-21 23:38:56.458] [INFO ] [http-nio-8881-exec-6] jdbc.sqltiming - SELECT /* BoardMapper.getPopularBoards (최근 15일 인기 게시글 조회) */
               B.BOARD_ID
             , B.TITLE
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             , B.CREATE_AT
             , M.USER_NAME
             , M.PROFILE_IMAGE
        FROM BOARD B
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        WHERE B.CREATE_AT >= DATE_SUB(NOW(), INTERVAL 15 DAY)
          AND B.DELETE_YN = 'N'
        ORDER BY B.LIKE_COUNT DESC, B.VIEW_COUNT DESC
        LIMIT 5

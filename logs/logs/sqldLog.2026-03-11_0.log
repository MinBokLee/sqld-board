             , B.TITLE
             , B.USER_ID
             , M.USER_NAME
             , B.MEMBER_ID
             , B.BOARD_TYPE
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             , B.CREATE_AT
         FROM BOARD B
            LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        WHERE B.CREATE_AT >= DATE_SUB(NOW(), INTERVAL 7 DAY) /* 최근 일주일 데이터 내에서만 */

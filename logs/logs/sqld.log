               B.BOARD_ID
             , B.TITLE
             , B.CONTENT
             , M.USER_ID
             , M.USER_NAME
             , B.MEMBER_ID
             , B.BOARD_CODE
             , B.CATEGORY_ID
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             ,(SELECT COUNT(*)
                 FROM COMMENT_MANAGEMENT CM
                WHERE CM.BOARD_ID = B.BOARD_ID
                  AND CM.DELETE_YN = 'N') AS commentCount /* 댓글 작성 수 */
             , M.PROFILE_IMAGE
             , B.CREATE_AT
             , B.UPDATE_AT
             , B.TAG_NAME
        FROM
            BOARD B
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        WHERE B.DELETE_YN = 'N'
        ORDER BY
            B.CREATE_AT DESC

             , B.VIEW_COUNT
             , B.LIKE_COUNT
             , M.PROFILE_IMAGE
             , B.CREATE_AT
             , B.UPDATE_AT
             , B.TAG_NAME
             , BS.SCRAP_ID /* 스크랩 고유 ID */
          FROM BOARD B
          LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
          LEFT JOIN BOARD_SCRAP BS ON B.BOARD_ID = BS.BOARD_ID AND BS.MEMBER_ID = NULL
         WHERE B.BOARD_ID = 77
           AND B.DELETE_YN = 'N'

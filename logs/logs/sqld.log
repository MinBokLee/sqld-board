             , M.USER_NAME
             , M.PROFILE_IMAGE
        FROM BOARD B
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        WHERE B.CREATE_AT >= DATE_SUB(NOW(), INTERVAL 15 DAY)
          AND B.DELETE_YN = 'N'
        ORDER BY B.LIKE_COUNT DESC, B.VIEW_COUNT DESC
        LIMIT 5

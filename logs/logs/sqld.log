[2026-05-27 00:18:17.486] [INFO ] [http-nio-8080-exec-4] jdbc.sqltiming - SELECT /* BoardMapper.getBoardListWithPaging (페이징 처리된 게시판 목록 조회 (지연 조인 최적화 적용)) */
               B.BOARD_ID
             , B.TITLE
             , B.CONTENT
             , M.USER_ID
             , M.USER_NAME
             , B.MEMBER_ID
             , B.BOARD_CODE
             , B.CATEGORY_ID
             , B.VIEW_COUNT
             , B.LIKE_COUNT
             ,(SELECT COUNT(*)
                 FROM COMMENT_MANAGEMENT CM
                 WHERE CM.BOARD_ID = B.BOARD_ID
                   AND CM.DELETE_YN = 'N') AS commentCount /* 댓글 작성 수 */
             , M.PROFILE_IMAGE
             , B.CREATE_AT
             , B.UPDATE_AT
             , B.TAG_NAME
          FROM BOARD B
    INNER JOIN ( /* 인덱스만 사용하여 필요한 ID들만 빠르게 추출 */
                SELECT BOARD_ID
                  FROM BOARD
             WHERE DELETE_YN = 'N'

                    AND BOARD_CODE = 'S' 
            ORDER BY CREATE_AT DESC
            LIMIT 30 OFFSET 0
        ) AS temp ON B.BOARD_ID = temp.BOARD_ID
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        ORDER BY B.CREATE_AT DESC
 {executed in 4 msec}

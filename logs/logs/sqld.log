                  FROM BOARD
             WHERE DELETE_YN = 'N'

                    AND BOARD_TYPE = 'S' 
            ORDER BY CREATE_AT DESC
            LIMIT 20 OFFSET 0
        ) AS temp ON B.BOARD_ID = temp.BOARD_ID
        LEFT JOIN MEMBER_INFO M ON B.MEMBER_ID = M.MEMBER_ID
        ORDER BY B.CREATE_AT DESC

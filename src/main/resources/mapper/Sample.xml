<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sqld_board.sqld.mapper.SampleMapper">

    <!-- SELECT -->
    <!-- SELECT -->
    <!-- SELECT -->

    <!-- MEMBER 정보 조회 -->
    <select id="searchMemberInfo" resultType="com.sqld_board.sqld.dto.response.sample.SampleDtoRes">
        SELECT USERS_ID   /* SampleMapper.searchMemberInfo*/
             , NAME
          FROM MEMBER
    </select>

    <!-- INSERT -->
    <!-- INSERT -->
    <!-- INSERT -->

    <insert id="saveSample" parameterType="com.sqld_board.sqld.dto.request.SampleDtoReq">
        INSERT INTO MEMBER
                    (USERS_ID, NAME)
        VALUES      (#{USERS_ID}, #{NAME})
    </insert>

</mapper>